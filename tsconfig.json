{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "useDefineForClassFields": false,
    "skipLibCheck": true,
    "types": [],
    "baseUrl": ".",
    "paths": {
      "glassy-liquid": ["src/index.ts"],
      "glassy-liquid/elements": ["src/elements.ts"],
      "glassy-liquid/react": ["src/react/index.ts"],
      "glassy-liquid/vue": ["src/vue/index.ts"],
      "glassy-liquid/svelte/actions": ["src/svelte/actions.ts"]
    }
  },
  "include": ["src", "docs/src"]
}
